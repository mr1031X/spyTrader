# Trading environment — paper is the default. Never commit the real .env file.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false

# Alpaca paper account (separate from live credentials)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Alpaca live account (kept disabled until the protected UI activation also passes)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Market data: IEX is not consolidated. SIP requires an entitled subscription.
# Execution requires Alpaca OPRA or production Tradier; indicative/sandbox data is blocked.
MARKET_DATA_PROVIDER=alpaca
ALPACA_STOCK_FEED=iex
ALPACA_OPTIONS_FEED=opra
TRADIER_API_KEY=
TRADIER_BASE_URL=https://api.tradier.com/v1

# Optional news classification (technical-only operation remains available)
BENZINGA_API_KEY=
TRADING_ECONOMICS_API_KEY=

# Initial strategy/risk defaults for a NEW SQLite database only.
# Later changes are persisted through the dashboard, not reread from this file.
TRADING_SYMBOLS=SPY,QQQ
INITIAL_PAPER_CAPITAL=10000
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS=1
MIN_SIGNAL_SCORE=80
MIN_ALLOCATION_PERCENT=5
STANDARD_ALLOCATION_PERCENT=10
MAX_ALLOCATION_PERCENT=15
INITIAL_STOP_LOSS_PERCENT=10
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PERCENT=20
TRAILING_DISTANCE_PERCENT=10
FIXED_PROFIT_TARGET_ENABLED=false
FIXED_PROFIT_TARGET_PERCENT=50
DAILY_PROFIT_GOAL=100
PAUSE_AFTER_DAILY_GOAL=true
DAILY_LOSS_LIMIT_PERCENT=6
WEEKLY_LOSS_LIMIT_PERCENT=12
MAX_CONSECUTIVE_LOSSES=2
NEW_ENTRY_CUTOFF_ET=15:00
LIQUIDATION_START_ET=15:40
TARGET_FLAT_TIME_ET=15:45
CLOSE_POSITIONS_EOD=true
NOTIFICATIONS_ENABLED=false

# Optional operator alerts; delivery failures never interrupt risk management.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=

# Runtime persistence and API listener
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/apex.db
API_HOST=0.0.0.0
API_PORT=8000
